{
  "name": "@pomeranian/lib-essential",
  "version": "0.1.0",
  "files": [
    "dist",
    "src"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.mjs",
      "require": "./dist/element.js"
    },
    "./fillable": {
      "types": "./dist/fillable.d.ts",
      "import": "./dist/fillable.mjs",
      "require": "./dist/fillable.js"
    },
    "./editable-value": {
      "types": "./dist/editable-value.d.ts",
      "import": "./dist/editable-value.mjs",
      "require": "./dist/editable-value.js"
    },
    "./checkable": {
      "types": "./dist/checkable.d.ts",
      "import": "./dist/checkable.mjs",
      "require": "./dist/checkable.js"
    },
    "./checkable-uncheckable": {
      "types": "./dist/checkable-uncheckable.d.ts",
      "import": "./dist/checkable-uncheckable.mjs",
      "require": "./dist/checkable-uncheckable.js"
    },
    "./selectable-options": {
      "types": "./dist/selectable-options.d.ts",
      "import": "./dist/selectable-options.mjs",
      "require": "./dist/selectable-options.js"
    },
    "./text-input": {
      "types": "./dist/text-input.d.ts",
      "import": "./dist/text-input.mjs",
      "require": "./dist/text-input.js"
    },
    "./text-area": {
      "types": "./dist/text-area.d.ts",
      "import": "./dist/text-area.mjs",
      "require": "./dist/text-area.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.mjs",
      "require": "./dist/checkbox.js"
    },
    "./radio": {
      "types": "./dist/radio.d.ts",
      "import": "./dist/radio.mjs",
      "require": "./dist/radio.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.mjs",
      "require": "./dist/select.js"
    },
    "./content-editable": {
      "types": "./dist/content-editable.d.ts",
      "import": "./dist/content-editable.mjs",
      "require": "./dist/content-editable.js"
    },
    "./editable-text": {
      "types": "./dist/editable-text.d.ts",
      "import": "./dist/editable-text.mjs",
      "require": "./dist/editable-text.js"
    }
  },
  "scripts": {
    "build": "node ../core/lib/build.mts && node lib/build.mts",
    "test": "pnpm run build && playwright test && pnpm run test:consumers",
    "typecheck": "node ../core/lib/build.mts && tsc -p tsconfig.node.json",
    "lint": "oxlint . --ignore-pattern prototypes",
    "lint:fix": "oxlint --fix . --ignore-pattern prototypes",
    "test:consumers": "node lib/verify-consumers.mts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@pomeranian/core": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "@repo/test-support": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@pomeranian/core": "^0.1.0",
    "playwright-core": ">=1.64.1 <2"
  }
}
