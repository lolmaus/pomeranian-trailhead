{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "packages/oxlint-config/**",
    "packages/typescript-config/**",
    "oxlint.config.mts",
    "oxfmt.config.mts",
    "tsconfig*.json",
    "lib/**",
    ".github/workflows/ci.yml"
  ],
  "tasks": {
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "PWDEBUG", "DISPLAY"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#typecheck:root": {
      "outputs": []
    }
  }
}
