{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "packages/oxlint-config/**",
    "packages/typescript-config/**",
    "!**/.turbo/**",
    "oxlint.config.mts",
    "oxfmt.config.mts",
    "tsconfig*.json",
    "lib/**",
    ".github/workflows/ci.yml",
    "packages/core/prototypes/factory-typing/**",
    "apps/storybook-react/.storybook/**",
    "apps/storybook-react/package.json",
    "packages/lib-ant-design/tests/**",
    "packages/lib-ant-design/package.json",
    "packages/lib-ant-design/tsconfig*.json",
    "packages/test-support/src/**",
    "packages/test-support/tests/fixtures/**",
    "packages/test-support/playwright.stories.config.mts",
    "packages/test-support/story-setup.mts",
    "packages/test-support/package.json",
    "packages/test-support/tsconfig*.json",
    "!**/node_modules/**",
    "!**/dist/**",
    "!**/test-results/**",
    "!**/playwright-report/**"
  ],
  "tasks": {
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "PWDEBUG", "DISPLAY", "STORYBOOK_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "@repo/docs#build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".generated/site/.vitepress/dist/**",
        ".generated/api/**",
        ".generated/content-model.json",
        ".generated/ready.json",
        ".generated/build.json"
      ],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "@repo/docs#check": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "PWDEBUG", "DISPLAY"]
    },
    "test:stories": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "PWDEBUG", "DISPLAY", "STORYBOOK_*"]
    }
  }
}
