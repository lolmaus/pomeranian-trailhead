{
  "name": "@repo/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node lib/cli.mts dev",
    "build": "node lib/cli.mts build",
    "preview": "node lib/cli.mts preview",
    "check": "pnpm run typecheck && pnpm run test",
    "test": "pnpm run build && playwright test",
    "test:unit": "playwright test --config playwright.unit.config.mts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --project tsconfig.node.json && node ../../node_modules/typescript/bin/tsc --project tsconfig.fixtures.json && node ../../node_modules/typescript/bin/tsc --project tsconfig.prototype.json && node ../../packages/core/prototypes/factory-typing/run.mjs --types-only"
  },
  "dependencies": {
    "@repo/test-support": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "markdown-it": "14.1.1",
    "oxlint": "1.89.0",
    "parse5": "8.0.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vue": "3.5.30"
  }
}
