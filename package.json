{
  "name": "pomeranian-trailhead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "turbo run test",
    "test:fresh": "turbo run test --force",
    "test:install": "pnpm --filter @repo/test-support exec playwright install chromium",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format && pnpm run test",
    "ci": "pnpm run lint:root && pnpm run typecheck:root && pnpm run format && node lib/ci.mts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:root:fix",
    "lint:root": "oxlint . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "lint:root:fix": "oxlint --fix . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit --project tsconfig.node.json",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "prepare": "lefthook install",
    "docs:dev": "pnpm --filter @repo/docs dev",
    "docs:build": "turbo run build --filter @repo/docs",
    "docs:preview": "pnpm --filter @repo/docs preview",
    "docs:check": "turbo run check --filter @repo/docs",
    "storybook": "pnpm --filter @repo/storybook-react dev"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
